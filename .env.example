# Пример переменных окружения. Реальные значения сюда НЕ вписываются
# и в репозиторий не попадают — они задаются в блоке "env" при деплое в Вайбкоде.

# Ключ Вайбкода: vibe_app_… для встраиваемого приложения или vibe_api_… для личного использования
VIBECODE_API_KEY=

# Необязательные параметры
VIBECODE_API_BASE=https://vibecode.bitrix24.tech
PORT=3000
DASHBOARD_CURRENCY=₸
DASHBOARD_RECENT_LIMIT=20
DASHBOARD_META_TTL_MS=300000
DASHBOARD_DATA_TTL_MS=30000
